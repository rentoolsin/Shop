{
  "name": "RenTools Admin",
  "short_name": "RTA",
  "description": "Manage rentals, products, customers, and requests for RenTools.",
  "start_url": "/admin/",
  "scope": "/admin/",
  "display": "standalone",
  "background_color": "#F7F7F5",
  "theme_color": "#121214",
  "icons": [
    { "src": "/admin-icon-192x192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/admin-icon-512x512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/admin-icon-maskable-512x512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "Rentals",
      "short_name": "Rentals",
      "description": "View and manage active rentals",
      "url": "/admin/rentals",
      "icons": [{ "src": "/admin-icon-192x192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Requests",
      "short_name": "Requests",
      "description": "Enquiries and purchase requests needing attention",
      "url": "/admin/enquiries",
      "icons": [{ "src": "/admin-icon-192x192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Products",
      "short_name": "Products",
      "description": "Manage the rental catalog",
      "url": "/admin/products",
      "icons": [{ "src": "/admin-icon-192x192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Customers",
      "short_name": "Customers",
      "description": "Look up customer records",
      "url": "/admin/customers",
      "icons": [{ "src": "/admin-icon-192x192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
